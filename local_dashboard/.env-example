# ── Dashboard access password (shown on login screen) ──────────────────────────
DASHBOARD_PASSWORD=mbp-admin-2026

# ── Email (GoDaddy legacy email / secureserver.net) ─────────────────────────────
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@muscleboxpro.com
SMTP_PASS=password  #update with your email password
SMTP_FROM="Muscle Box Pro <contact@muscleboxpro.com>"
IMAP_HOST=imap.secureserver.net
IMAP_PORT=993

# ── Supabase (service role for DB reads) ────────────────────────────────────────
SUPABASE_URL=copy your supabase project url #update with your supabase project url
SUPABASE_SERVICE_ROLE_KEY=copy your supabase service role key #update with your supabase service role key

# ── PhonePe Payment Gateway ─────────────────────────────────────────────────────
PHONEPE_ENV=production
PHONEPE_CLIENT_ID=phonepe client id #update with your phonepe client id
PHONEPE_CLIENT_SECRET=phonepe client secret #update with your phonepe client secret
PHONEPE_CLIENT_VERSION=1
PHONEPE_VPA=your phonepe vpa #update with your phonepe vpa
PHONEPE_TOKEN_URL=https://api.phonepe.com/apis/identity-manager/v1/oauth/token
PHONEPE_PAY_URL=https://api.phonepe.com/apis/pg/checkout/v2/pay
PHONEPE_STATUS_URL=https://api.phonepe.com/apis/pg/checkout/v2/order

# ── Server ──────────────────────────────────────────────────────────────────────
PORT=4000
